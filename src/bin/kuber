#!/usr/bin/env bash
# OLS command: kuber

set -euo pipefail
IFS=$'\n\t'

# shellcheck source=src/lib/env.sh
source "$HOME/.local/share/OLS/lib/env.sh"

show_help() {
    cat <<'EOF'
kuber - k8s setting
usage:
    kuber deploy                  # deploy app
    kuber switch <namespace>      # switch to namespace
    kuber ns <action> <namespace> # setting namespace
EOF
}

command -v kubectl >/dev/null 2>&1 || ee "kubectl not found"
command -v minikube >/dev/null 2>&1 || warn "minikube not found"

if [[ "${1-}" == "--help" ]]; then
    show_help
    exit 0
fi

case "${1-}" in
    deploy)
        kubectl apply -f . -R
        ;;
    switch)
        if [[ -n "${2-}" ]]; then
            kubectl config set-context --current --namespace="${2-}"
        else
            echo "Invalid Argument"
            ee "Invalid argument"
        fi
        ;;
    ns)
        case "${2-}" in
            add)
                if [[ -n "${3-}" ]]; then
                    kubectl create namespace "${3-}"
                else
                    echo "Invalid Argument"
                    ee "Invalid argument"
                fi
                ;;
            rm)
                if [[ -n "${3-}" ]]; then
                    kubectl delete namespace "${3-}"
                else
                    echo "Invalid Argument"
                    ee "Invalid argument"
                fi
                ;;
        esac
        ;;

    *)
        ee "Invalid argument"
        ;;
esac
