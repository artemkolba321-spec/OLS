#!/usr/bin/env bash
# OLS command: ossh

set -euo pipefail
IFS=$'\n\t'

# shellcheck source=src/lib/env.sh
source "$HOME/.local/share/OLS/lib/env.sh"

show_help() {
    cat <<'EOF'
usage:
    ossh root@<server> # include server
    ossh keygen        # generate ssh key
EOF
}
command -v ssh >/dev/null 2>&1 || ee "ssh not found"
if [[ "${1-}" == "--help" ]]; then
    show_help
    exit 0
fi

case "${1-}" in
    keygen)
        ssh-keygen -t ed25519
        ;;
    *)
        if [[ -n ${2-} ]]; then
            ssh -vvv ${2-}
        else
            ee "Invalid argument"
        fi
        ;;
esac
